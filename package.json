{
  "name": "findit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:backend && npm run test:auth && npm run db:test",
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test:backend": "node --test server/tests/*.test.js",
    "test:items": "node --test server/tests/items.test.js",
    "test:backend:integration": "node --test server/tests/*.integration.js",
    "test:auth": "node --test server/tests/auth/*.test.js",
    "test:auth:integration": "node --test server/tests/auth/*.integration.js",
    "backend:check-db": "node server/scripts/check-db.js",
    "db:init": "node database/scripts/cli.js init",
    "db:migrate": "node database/scripts/cli.js migrate",
    "db:seed": "node database/scripts/cli.js seed",
    "db:setup": "node database/scripts/cli.js setup",
    "db:verify": "node database/scripts/cli.js verify",
    "db:build": "node database/scripts/build.js",
    "db:test": "node --test database/tests/*.test.js",
    "db:test:integration": "node --test database/tests/mysql.integration.js",
    "db:test:isolated": "node database/scripts/test-isolated.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.15.3"
  }
}
