{
  "name": "findit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:backend && npm run test:auth && npm run db:test",
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "worker:ai-visual": "node server/ai-visual/main.js",
    "ai-visual:smoke": "node server/ai-visual/smoke.js",
    "test:backend": "node --test server/tests/*.test.js",
    "test:items": "node --test server/tests/items.test.js",
    "test:claims": "node --test server/tests/claims.test.js",
    "test:backend:integration": "node --test server/tests/*.integration.js",
    "test:auth": "node --test server/tests/auth/*.test.js",
    "test:auth:integration": "node --test server/tests/auth/*.integration.js",
    "test:integration:isolated": "node database/scripts/test-isolated.js --all",
    "backend:check-db": "node server/scripts/check-db.js",
    "images:cleanup": "node server/scripts/cleanup-images.js",
    "db:init": "node database/scripts/cli.js init",
    "db:migrate": "node database/scripts/cli.js migrate",
    "db:seed": "node database/scripts/cli.js seed",
    "db:setup": "node database/scripts/cli.js setup",
    "db:verify": "node database/scripts/cli.js verify",
    "db:build": "node database/scripts/build.js",
    "db:test": "node --test database/tests/*.test.js",
    "db:test:integration": "node --test database/tests/mysql.integration.js",
    "db:test:isolated": "node database/scripts/test-isolated.js",
    "test:security": "node --test server/tests/security.test.js",
    "test:security:isolated": "node database/scripts/test-isolated.js --security",
    "test:regression": "npm test && npm run test:integration:isolated",
    "test:coverage": "node server/scripts/test-coverage.js",
    "test:coverage:integration": "node server/scripts/test-coverage.js integration",
    "test:coverage:combined": "node server/scripts/test-coverage.js combined",
    "audit:production": "npm audit --omit=dev"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.15.3",
    "sharp": "0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "c8": "12.0.0"
  }
}
