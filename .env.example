# Copy to .env locally. Never commit .env or real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=findit_db

# Backend defaults also apply when these variables are absent in an existing .env.
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Required for db:seed / db:setup. Use dedicated local test accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
