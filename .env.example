# Copy to .env locally. Never commit .env or real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=findit_db

# Shared Resend HTTPS delivery. Leave empty to disable email without stopping the API.
# Use a sending-only key and an address on your verified Resend domain.
# Disable open/click tracking on that domain, especially for password reset emails.
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173

# Backend defaults also apply when these variables are absent in an existing .env.
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Single process; do not enable proxy trust without a reviewed deployment topology.
# NODE_ENV=production enables HSTS and CSP upgrade-insecure-requests (requires HTTPS).
NODE_ENV=development
RATE_LIMIT_API_MAX=300
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_UPLOAD_MAX=10

# Generate locally with crypto.randomBytes(32). Never use a committed secret.
JWT_SECRET=
# Integer seconds, not a duration string.
JWT_EXPIRES_IN=3600

# Optional image uploads. Required only for POST /api/items/:id/images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared per-process upload/delete/cleanup budget (pool size: 10).
# Concurrency: 1-9; queue limit: >=0; wait: positive milliseconds.
IMAGE_OPERATION_CONCURRENCY=4
IMAGE_OPERATION_QUEUE_LIMIT=20
IMAGE_OPERATION_WAIT_MS=5000

# Required for db:seed / db:setup. Use dedicated local test accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Readiness: per-IP quota; probe deadline requires deployment-specific validation.
RATE_LIMIT_HEALTH_MAX=60
HEALTH_PROBE_TIMEOUT_MS=1000
