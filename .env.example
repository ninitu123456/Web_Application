# Copy to .env locally. Never commit .env or real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=findit_db

# Backend defaults also apply when these variables are absent in an existing .env.
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Generate locally with crypto.randomBytes(32). Never use a committed secret.
JWT_SECRET=
# Integer seconds, not a duration string.
JWT_EXPIRES_IN=3600

# Optional image uploads. Required only for POST /api/items/:id/images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for db:seed / db:setup. Use dedicated local test accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
