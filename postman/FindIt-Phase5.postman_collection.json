{
  "info": {
    "name": "FindIt Phase 5 - Notifications and Reports",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use a local test instance. Set JWT tokens and existing resource IDs; no production credentials are included."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "itemId",
      "value": "1"
    },
    {
      "key": "notificationId",
      "value": "1"
    },
    {
      "key": "reportId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List mine",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/notifications?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const rows = pm.response.json().data; if (rows.length) pm.collectionVariables.set('notificationId', rows[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Unread count",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/notifications/unread-count"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark one read",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark all read",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/notifications/read-all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Create Report",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetType\": \"ITEM\",\n  \"targetId\": {{itemId}},\n  \"reason\": \"Thông tin cần kiểm tra\",\n  \"description\": \"Ví dụ kiểm thử Phase 5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('reportId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My Reports",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/reports/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin list pending",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/admin/reports?status=PENDING&page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Begin review",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/reports/{{reportId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REVIEWING\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/reports/{{reportId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resubmit after resolved",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetType\": \"ITEM\",\n  \"targetId\": {{itemId}},\n  \"reason\": \"Thông tin cần kiểm tra\",\n  \"description\": \"Ví dụ kiểm thử Phase 5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('reportId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Begin second review",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/reports/{{reportId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REVIEWING\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dismiss",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/reports/{{reportId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DISMISSED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
