    {
      "name": "Admin moderation and disputes (F04/F05)",
      "description": "Isolated test instance only. Use unrelated ACTIVE ADMIN and consistent pending fixtures. Resolve and close change state; recreate fixtures for another decision. CLOSED does not hide public content; terminal Claims cannot be reversed. Legacy status stays OPEN-only.",
      "item": [
        {
          "name": "List Claim summaries",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/admin/claims?page=1&limit=10&status=PENDING&sort=newest"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('No store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve pending Claim",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
